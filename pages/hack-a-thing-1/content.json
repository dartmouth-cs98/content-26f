            {
              "type": "text",
              "text": "README.md",
              "styles": {}
            }
          ]
        },
        {
          "type": "text",
          "text": " file. There are many good tutorials out there - popular choices are react-native, Unity3D, voice technologies, AR/VR, etc. ",
          "styles": {}
        },
        {
          "type": "link",
          "href": "http://lynda.dartmouth.edu/",
          "content": [
            {
              "type": "text",
              "text": "http://lynda.dartmouth.edu/",
              "styles": {}
            }
          ]
        },
        {
          "type": "text",
          "text": " is a decent source for some.",
          "styles": {}
        }
      ],
      "children": []
