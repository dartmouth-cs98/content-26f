        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Remember to acknowledge any tutorials or resources you used in your ",
          "styles": {}
        },
        {
          "type": "link",
          "href": "https://cs98.me/projects/milestones/hack-a-thing-1#readme",
