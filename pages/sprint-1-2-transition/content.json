        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "🚀 Assign ",
          "styles": {}
        },
        {
          "type": "text",
          "text": "@timofei7",
          "styles": {
            "code": true
          }
        },
        {
          "type": "text",
          "text": " to the issue so we can review and give feedback. Thanks!",
          "styles": {}
        }
      ],
      "children": []
