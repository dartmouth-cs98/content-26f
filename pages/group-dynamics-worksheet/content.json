    },
    {
      "id": "7b5a8f78-7e55-4a73-bb23-d8ada526f1c1",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Once everyone on your team is finished with Part A, go around and share your responses to the two Role questions.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "4fbf1553-e7fa-40c8-8f2e-ac3a9c3a235f",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "You may use ",
          "styles": {}
        },
        {
