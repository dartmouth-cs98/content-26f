        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "We’ll use this opportunity to get your first project repo started (if you haven’t already)! We’ll be using Classmoji to autoprovision repositories and set up teams.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "62378edf-d590-4f29-aa52-ae083921eae6",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Your teams area already set up in Classmoji and you have a project-teamname repository. ",
          "styles": {}
        }
      ],
      "children": []
    },
