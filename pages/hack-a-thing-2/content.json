      "type": "heading",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left",
        "level": 1,
        "isToggleable": false
      },
      "content": [
        {
          "type": "text",
          "text": "README",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "3467712e-5f1f-4300-beeb-29d54c11994c",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "All your projects on github should include a README.md file. For this milestone all it needs is:",
          "styles": {}
        }
      ],
      "children": []
    },
