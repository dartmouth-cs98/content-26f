      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "How does this hack-a-thing inspire you or relate to your possible project ideas?",
          "styles": {}
