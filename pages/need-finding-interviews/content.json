      "content": [
        {
          "type": "text",
          "text": "Empathize and Summarize",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "c2bd2870-a962-4996-9be5-ff09724958fe",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Try to draw some conclusions at the end, in particular identify the problem statement. This is not your proposed solution to the problem, just a summary of what you think the generalized problem is. ",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "7d225a5d-83ce-49c5-ab30-aef67c38d343",
      "type": "paragraph",
